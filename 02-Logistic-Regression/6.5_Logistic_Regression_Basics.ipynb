{"cells": [{"cell_type": "markdown", "metadata": {}, "source": ["# 6.5 Logistic Regression Basics\n", "\n", "**Objective:** Binary Classification using Iris Dataset\n", "\n", "**Dataset:** Iris Flower Dataset (Binary Classification: Setosa vs Versicolor)\n", "\n", "**Key Concepts:**\n", "- Binary logistic regression\n", "- Feature scaling for optimal performance\n", "- Decision boundary visualization\n", "- Confusion matrix interpretation"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import pandas as pd\n", "import numpy as np\n", "import matplotlib.pyplot as plt\n", "from sklearn.linear_model import LogisticRegression\n", "from sklearn.metrics import accuracy_score, confusion_matrix, classification_report, roc_auc_score, roc_curve\n", "from sklearn.model_selection import train_test_split, cross_val_score\n", "from sklearn.preprocessing import StandardScaler\n", "import os\n", "import warnings\n", "warnings.filterwarnings('ignore')\n", "\n", "# Use THIS notebook's folder paths\n", "NOTEBOOK_DIR = os.getcwd()\n", "DATASETS_DIR = os.path.join(NOTEBOOK_DIR, 'datasets')\n", "OUTPUTS_DIR = os.path.join(NOTEBOOK_DIR, 'outputs')\n", "os.makedirs(OUTPUTS_DIR, exist_ok=True)\n", "\n", "print(f\"✅ Environment ready!\")\n", "print(f\"📁 Datasets: {DATASETS_DIR}\")\n", "print(f\"📁 Outputs: {OUTPUTS_DIR}\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# STEP 1: Load and Explore Dataset\n", "print(\"=\" * 60)\n", "print(\"STEP 1: DATA LOADING & EXPLORATION\")\n", "print(\"=\" * 60)\n", "\n", "# Load iris dataset\n", "df = pd.read_csv(os.path.join(DATASETS_DIR, 'iris.csv'))\n", "\n", "# For binary classification, use only Setosa and Versicolor\n", "df_binary = df[df['species'].isin(['setosa', 'versicolor'])].copy()\n", "\n", "print(f\"\\n📊 Original Dataset Shape: {df.shape}\")\n", "print(f\"📊 Binary Subset Shape: {df_binary.shape}\")\n", "print(f\"\\n📋 Columns: {list(df_binary.columns)}\")\n", "\n", "print(f\"\\n📈 Class Distribution:\")\n", "print(df_binary['species'].value_counts().to_string())\n", "\n", "print(f\"\\n📝 First 10 rows:\")\n", "print(df_binary.head(10))\n", "\n", "print(f\"\\n📊 Statistical Summary:\")\n", "print(df_binary.describe().round(2))"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# STEP 2: Prepare Features & Target + Encode Labels\n", "print(\"=\" * 60)\n", "print(\"STEP 2: DATA PREPARATION\")\n", "print(\"=\" * 60)\n", "\n", "# Select features (use sepal measurements for visualization)\n", "feature_cols = ['sepal_length', 'sepal_width']\n", "X = df_binary[feature_cols].values\n", "\n", "# Encode target variable (setosa=0, versicolor=1)\n", "y = (df_binary['species'] == 'versicolor').astype(int).values\n", "\n", "print(f\"\\n✅ Features selected: {feature_cols}\")\n", "print(f\"   Feature matrix shape: {X.shape}\")\n", "print(f\"\\n✅ Target encoded:\")\n", "print(f\"   0 = setosa (count: {np.sum(y==0)})\")\n", "print(f\"   1 = versicolor (count: {np.sum(y==1)})\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# STEP 3: Train/Test Split\n", "print(\"=\" * 60)\n", "print(\"STEP 3: TRAIN/TEST SPLIT\")\n", "print(\"=\" * 60)\n", "\n", "# Split data (stratified to maintain class ratio)\n", "X_train, X_test, y_train, y_test = train_test_split(\n", "    X, y, test_size=0.3, random_state=42, stratify=y\n", ")\n", "\n", "print(f\"\\n📦 Total samples: {len(X)}\")\n", "print(f\"   Training set: {len(X_train)} samples ({len(X_train)/len(X)*100:.1f}%)\")\n", "print(f\"   Test set: {len(X_test)} samples ({len(X_test)/len(X)*100:.1f}%)\")\n", "\n", "print(f\"\\n📊 Training class distribution:\")\n", "print(f\"   Class 0 (setosa): {np.sum(y_train==0)}\")\n", "print(f\"   Class 1 (versicolor): {np.sum(y_train==1)}\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# STEP 4: Feature Scaling\n", "print(\"=\" * 60)\n", "print(\"STEP 4: FEATURE SCALING\")\n", "print(\"=\" * 60)\n", "\n", "# Initialize scaler\n", "scaler = StandardScaler()\n", "\n", "# Fit on training data and transform both sets\n", "X_train_scaled = scaler.fit_transform(X_train)\n", "X_test_scaled = scaler.transform(X_test)\n", "\n", "print(\"\\n✅ Features scaled using StandardScaler\")\n", "print(f\"\\n📊 Scaled Feature Statistics (Training Set):\")\n", "for i, col in enumerate(feature_cols):\n", "    print(f\"   {col}:\")\n", "    print(f\"      Mean: {X_train_scaled[:, i].mean():.4f} (should be ~0)\")\n", "    print(f\"      Std:  {X_train_scaled[:, i].std():.4f} (should be ~1)\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# STEP 5: Train Logistic Regression Model\n", "print(\"=\" * 60)\n", "print(\"STEP 5: MODEL TRAINING\")\n", "print(\"=\" * 60)\n", "\n", "# Initialize and train model\n", "model = LogisticRegression(max_iter=200, random_state=42)\n", "model.fit(X_train_scaled, y_train)\n", "\n", "# Make predictions\n", "y_pred = model.predict(X_test_scaled)\n", "y_prob = model.predict_proba(X_test_scaled)[:, 1]\n", "\n", "print(\"\\n✅ Model trained successfully!\")\n", "print(f\"\\n📈 Model Parameters:\")\n", "print(f\"   Intercept (bias): {model.intercept_[0]:.4f}\")\n", "print(f\"\\n   Coefficients:\")\n", "for feature, coef in zip(feature_cols, model.coef_[0]):\n", "    print(f\"      {feature}: {coef:+.4f}\")\n", "\n", "print(f\"\\n🔢 Logistic Regression Equation:\")\n", "eq = f\"z = {model.intercept_[0]:.3f}\"\n", "for f, c in zip(feature_cols, model.coef_[0]):\n", "    eq += f\" + ({c:.3f} × {f})\"\n", "print(f\"   {eq}\")\n", "print(f\"   P(versicolor) = 1 / (1 + e^(-z))\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# STEP 6: Model Evaluation\n", "print(\"=\" * 60)\n", "print(\"STEP 6: MODEL EVALUATION\")\n", "print(\"=\" * 60)\n", "\n", "# Calculate metrics\n", "accuracy = accuracy_score(y_test, y_pred)\n", "cm = confusion_matrix(y_test, y_pred)\n", "roc_auc = roc_auc_score(y_test, y_prob)\n", "\n", "tn, fp, fn, tp = cm.ravel()\n", "precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n", "recall = tp / (tp + fn) if (tp + fn) > 0 else 0\n", "specificity = tn / (tn + fp) if (tn + fp) > 0 else 0\n", "\n", "print(f\"\\n📊 ACCURACY METRICS:\")\n", "print(f\"   Overall Accuracy:     {accuracy:.4f} ({accuracy*100:.1f}%)\")\n", "print(f\"   ROC AUC Score:        {roc_auc:.4f}\")\n", "\n", "print(f\"\\n📊 CONFUSION MATRIX:\")\n", "print(f\"   ┌─────────────────────────┐\")\n", "print(f\"   │ Predicted: 0    Predicted: 1 │\")\n", "print(f\"   ├─────────────────────────┤\")\n", "print(f\"   │ Actual 0:  TN={tn:3d}    FP={fp:3d}      │  (Setosa)\")\n", "print(f\"   │ Actual 1:  FN={fn:3d}    TP={tp:3d}      │  (Versicolor)\")\n", "print(f\"   └─────────────────────────┘\")\n", "\n", "print(f\"\\n📊 DETAILED METRICS:\")\n", "print(f\"   True Positives (TP):    {tp} (correctly identified versicolor)\")\n", "print(f\"   True Negatives (TN):    {tn} (correctly identified setosa)\")\n", "print(f\"   False Positives (FP):   {fp} (setosa misclassified as versicolor)\")\n", "print(f\"   False Negatives (FN):   {fn} (versicolor misclassified as setosa)\")\n", "\n", "print(f\"\\n   Precision (Positive):  {precision:.4f}\")\n", "print(f\"   Recall/Sensitivity:    {recall:.4f} ({recall*100:.1f}% of versicolor detected)\")\n", "print(f\"   Specificity:           {specificity:.4f} ({specificity*100:.1f}% of setosa detected)\")\n", "\n", "print(f\"\\n📊 CLASSIFICATION REPORT:\")\n", "print(classification_report(y_test, y_pred, target_names=['Setosa (0)', 'Versicolor (1)']))"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# STEP 7: Cross-Validation\n", "print(\"=\" * 60)\n", "print(\"STEP 7: CROSS-VALIDATION\")\n", "print(\"=\" * 60)\n", "\n", "# Perform cross-validation on full dataset\n", "cv_model = LogisticRegression(max_iter=200, random_state=42)\n", "X_scaled_full = StandardScaler().fit_transform(X)\n", "\n", "cv_scores = cross_val_score(cv_model, X_scaled_full, y, cv=5)\n", "\n", "print(f\"\\n🔄 5-Fold Cross-Validation Results:\")\n", "for i, score in enumerate(cv_scores, 1):\n", "    print(f\"   Fold {i}: {score:.4f}\")\n", "\n", "print(f\"\\n   Mean Accuracy: {cv_scores.mean():.4f}\")\n", "print(f\"   Std Deviation: ±{cv_scores.std():.4f}\")\n", "print(f\"   Range: [{cv_scores.min():.4f}, {cv_scores.max():.4f}]\")\n", "print(f\"\\n✅ Cross-validation complete - Model is stable!\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# STEP 8: Visualizations\n", "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n", "\n", "# Plot 1: Confusion Matrix Heatmap\n", "im = axes[0].imshow(cm, interpolation='nearest', cmap=plt.cm.RdPu_r')\n", "axes[0].set_title('Confusion Matrix\\n(Logistic Regression)', fontsize=12, fontweight='bold')\n", "plt.colorbar(im, ax=axes[0])\n", "\n", "# Add text annotations\n", "classes = ['Setosa', 'Versicolor']\n", "tick_marks = np.arange(len(classes))\n", "axes[0].set_xticks(tick_marks)\n", "axes[0].set_yticks(tick_marks)\n", "axes[0].set_xticklabels(classes)\n", "axes[0].set_yticklabels(classes)\n", "axes[0].set_xlabel('Predicted Label', fontsize=11)\n", "axes[0].set_ylabel('Actual Label', fontsize=11)\n", "\n", "# Add counts in cells\n", "thresh = cm.max() / 2.\n", "for i in range(cm.shape[0]):\n", "    for j in range(cm.shape[1]):\n", "        color = \"white\" if cm[i, j] > thresh else \"black\"\n", "        axes[0].text(j, i, format(cm[i, j], 'd'), ha=\"center\", va=\"center\", \n", "                   color=color, fontsize=16, fontweight='bold')\n", "\n", "# Plot 2: ROC Curve\n", "fpr, tpr, _ = roc_curve(y_test, y_prob)\n", "axes[1].plot(fpr, tpr, color='#8B008B', linewidth=2.5, label=f'ROC Curve (AUC = {roc_auc:.3f})')\n", "axes[1].plot([0, 1], [0, 1], color='gray', linestyle='--', linewidth=1.5, label='Random Classifier')\n", "axes[1].fill_between(fpr, tpr, alpha=0.25, color='#8B008B')\n", "axes[1].scatter([fpr[np.argmax(tpr - fpr)]], [tpr[np.argmax(tpr - fpr)]], \n", "            s=100, c='red', marker='*', zorder=5, label='Optimal Threshold')\n", "axes[1].set_xlabel('False Positive Rate', fontsize=11)\n", "axes[1].set_ylabel('True Positive Rate (Recall)', fontsize=11)\n", "axes[1].set_title('ROC Curve\\n(Binary Classification)', fontsize=12, fontweight='bold')\n", "axes[1].legend(loc='lower right', fontsize=10)\n", "axes[1].grid(alpha=0.3)\n", "axes[1].set_xlim([0.0, 1.0])\n", "axes[1].set_ylim([0.0, 1.05])\n", "\n", "plt.suptitle('6.5: Logistic Regression Basics - Binary Classification Results', \n", "             fontsize=14, fontweight='bold', y=1.02)\n", "plt.tight_layout()\n", "plt.savefig(os.path.join(OUTPUTS_DIR, '6.5_Logistic_Regression_Basics.png'), dpi=150, bbox_inches='tight')\n", "plt.show()\n", "\n", "print(f\"\\n✅ Visualization saved: {OUTPUTS_DIR}/6.5_Logistic_Regression_Basics.png\")"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## Summary\n", "\n", "### What We Learned:\n", "1. **Binary Classification**: Distinguishing between two classes (Setosa vs Versicolor)\n", "2. **Feature Scaling**: Standardizing features improves model convergence\n", "3. **Logistic Regression**: Linear model for classification using sigmoid function\n", "4. **Evaluation Metrics**: Beyond accuracy - precision, recall, ROC-AUC\n", "\n", "### Key Results:\n", f"- **Accuracy**: ~{accuracy*100:.1f}%\n", f"- **ROC-AUC**: {roc_auc:.3f}\n", f"- **Confusion Matrix**: TN={tn}, FP={fp}, FN={fn}, TP={tp}\n", "\n", "### Why This Works Well:\n", "- Setosa and Versicolor are **linearly separable** in feature space\n", "- High accuracy is expected for this well-behaved dataset\n", "- Demonstrates ideal case for logistic regression"]}], "metadata": {"kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"}, "language_info": {"name": "python", "version": "3.10.0"}}, "nbformat": 4, "nbformat_minor": 5}